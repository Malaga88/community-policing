# Copy this file to .env and fill in your own values.
# .env is where secrets live — never commit it to Git.

# MongoDB connection string.
# Local install:            mongodb://127.0.0.1:27017/gubiwatch
# MongoDB Atlas (cloud):    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gubiwatch
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.41mzuxi.mongodb.net/gubiwatch

# Port the Express server listens on.
PORT=5000

# Secret used to sign JSON Web Tokens for identified student accounts.
# Use a long, random string in production — never reuse this example value.
JWT_SECRET=change_this_to_a_long_random_string

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d
